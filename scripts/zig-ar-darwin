#!/bin/bash
# `zig ar --format=darwin` as a single executable, for CMAKE_AR (which takes one path, not
# a multi-word command). On a macOS target, archives must be Mach-O/BSD format: a plain
# `zig ar` defaults to GNU format, and a GNU-format archive of Mach-O .o makes zig's Mach-O
# LINKER reject the symbol table at link time with "unknown cpu architecture: <number>"
# (it misreads the GNU symbol table as a cputype). setup_zig_env already exports
# AR="zig ar --format=darwin" for autoconf/meson builds, but LLVM's cmake ignores $AR and
# auto-detects an archiver — so the clang PKGBUILD's darwin main build points CMAKE_AR at
# this wrapper instead. zigcc/zigc++ stay as-is; only the archiver needs the format flag.
exec zig ar --format=darwin "$@"
