#!/bin/bash
# zig cc wrapper, optionally routed through sccache. Shared logic lives in
# zig-common.sh, which we SOURCE (not exec) so $0 stays this script — sccache
# probes the wrapped compiler via $0, so it must be a real clang-like cc, not a
# sub-driver. See zig-common.sh for the sccache two-role trick and why.
source "$(dirname "$(readlink -f "$0")")/zig-common.sh"

zig_handle_dumpmachine "$@"    # gcc-compatible -dumpmachine (exits 0); see zig-common.sh
zig_sccache_reexec "$@"        # outer role re-execs under sccache; inner falls through
zig_filter_args "$@"           # ZIG_ARGS (filtered), ZIG_IS_COMPILE — see zig-common.sh
exec zig cc -target "$ZIG_CC_TARGET" "${ZIG_ARGS[@]}" "${ZIG_WNO[@]}"
