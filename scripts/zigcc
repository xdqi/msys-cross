#!/bin/bash
# zig cc wrapper, optionally routed through sccache. The entire body lives in
# zig-common.sh; this file is intentionally just a shebang + one `source`, passing the
# mode token `cc` so zig-common.sh drives `zig cc`. It is SOURCED (not exec'd) so the
# cc mode and arg-filtering run in this process before the wrapper hands the real compile
# to `sccache zig cc` (see zig-common.sh) — the shape that trips sccache's is_zig gate and
# distributes the TU. Not a symlink either: two tiny wrappers passing distinct modes
# (cc vs c++) is the point. See zig-common.sh.
source "$(dirname "$(readlink -f "$0")")/zig-common.sh" cc "$@"
