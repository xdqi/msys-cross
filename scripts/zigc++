#!/bin/bash
# zig c++ wrapper, optionally routed through sccache. See zigcc for the
# two-role (_ZIGCC_INNER) sccache trick; the only difference here is that
# compile invocations (-c/-E/-S) need an explicit `-x c++`.
if [ -z "${_ZIGCC_INNER:-}" ]; then
    _sccache="${SCCACHE_PATH:-}"
    [ -z "$_sccache" ] && _sccache="$(command -v sccache 2>/dev/null || true)"
    if [ -n "$_sccache" ]; then
        _ZIGCC_INNER=1 exec "$_sccache" "$0" "$@"
    fi
fi
unset _ZIGCC_INNER 2>/dev/null || true

# Detect compile (needs -x c++), then drop GCC's bare developer warning switches
# (-Wall/-Wextra/-W/-Werror) — clang-only diagnostics that don't apply to GCC's
# code. Functional -Werror=*/-Wno-* forms are preserved (exact match only).
is_compile=false
args=()
for a in "$@"; do
    case "$a" in
        -c|-E|-S) is_compile=true ;;
        -Wall|-Wextra|-W|-Werror) continue ;;
    esac
    args+=("$a")
done
if $is_compile; then
    exec zig c++ -x c++ -target x86_64-linux-gnu.2.11 "${args[@]}"
else
    exec zig c++ -target x86_64-linux-gnu.2.11 "${args[@]}"
fi
