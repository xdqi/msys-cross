#!/bin/bash
# zig c++ wrapper, optionally routed through sccache. The entire body lives in
# zig-common.sh; this file is intentionally just a shebang + one `source`, passing the
# mode token `c++` so zig-common.sh drives `zig c++` and adds an explicit `-x c++` on
# compile invocations (so a .c source is compiled as C++ — see zig-common.sh). SOURCED,
# not exec'd, so $0 stays this script for sccache's probe; not a symlink either (a
# symlink would collide the cc/c++ sccache cache keys). See zig-common.sh for the rest.
source "$(dirname "$(readlink -f "$0")")/zig-common.sh" c++ "$@"
