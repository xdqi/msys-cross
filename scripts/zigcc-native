#!/bin/bash
# Host-native zig cc: forces ZIG_TARGET=native (→ the build machine's gnu target, see
# zig-common.sh) so the clang PKGBUILD's stage-1 native LLVM build produces tablegens
# (llvm-tblgen / clang-tblgen / llvm-min-tblgen) that run on the build machine, regardless
# of the main toolchain's ZIG_TARGET (e.g. aarch64-macos). The main build then consumes
# them via -DLLVM_NATIVE_TOOL_DIR. Execs zigcc so $0 there stays a real cc for sccache.
exec env ZIG_TARGET=native "$(dirname "$(readlink -f "$0")")/zigcc" "$@"
