# Maintainer: msys2-cross project
_startdir="$(cd "$(dirname "${BASH_SOURCE[0]}")" && pwd)"
source "$_startdir/../../scripts/msys-cross-common.sh"
inherit_msys2 "mingw-w64-cross-binutils"

# ---- Add our NT weak externals patches ----
_our_binutils_patches=(
    0001-Fix-linker-error-when-using-NT-weak-externals.patch
    0002-Relocate-aux-entries-for-NT-weak-externals.patch
    0003-Convert-NT-weak-externals-to-locals.patch
    0004-Resolve-weak-externals-by-name-rather-than-stale-tag.patch
)
for p in "${_our_binutils_patches[@]}"; do
    source+=("file://$_startdir/$p")
    sha256sums+=('SKIP')
done

# ---- Package metadata ----
_our_pkgrel=1
pkgrel="${_msys2_pkgrel}.${_our_pkgrel}"

# ---- Single-target build (one target per makepkg run) ----
# MSYS_CROSS_TARGET selects exactly ONE target: mingw64 | mingw32 | ucrt64 | cygwin.
# Default mingw64 so a bare `makepkg` / `makepkg --packagelist` is well-defined;
# scripts/build.sh sets it explicitly once per target. The single value drives the
# per-target DEBUG package: pkgbase is set to this target's binutils package below,
# so makepkg's native split emits "<pkgbase>-debug" = msys-cross-<target>-binutils-debug
# (makepkg hardcodes the debug pkg name to $pkgbase-debug — per-target debug
# REQUIRES a per-target pkgbase, i.e. one target per run).
_mct="${MSYS_CROSS_TARGET:-mingw64}"

# _mct → host target triple + MSYS2 sysroot subdir.
case "$_mct" in
    mingw64) _mct_triple=x86_64-w64-mingw32;     _mct_subdir=mingw64 ;;
    mingw32) _mct_triple=i686-w64-mingw32;       _mct_subdir=mingw32 ;;
    ucrt64)  _mct_triple=x86_64-w64-mingw32ucrt; _mct_subdir=ucrt64 ;;
    cygwin)  _mct_triple=x86_64-pc-cygwin;       _mct_subdir=usr ;;
    *) echo "ERROR: MSYS_CROSS_TARGET must be mingw64|mingw32|ucrt64|cygwin (got '$_mct')" >&2
       return 1 2>/dev/null || exit 1 ;;
esac

# Override the inherited upstream pkgbase so the split debug package is per-target:
# msys-cross-<target>-binutils-debug (not a single all-target debug package).
pkgbase="msys-cross-${_mct}-binutils"
# pkgname for THIS target only: the <target>-binutils package. The target-independent
# binutils-common (BFD plugins, shared by every binutils) rides along with the
# mingw64 run. makepkg appends <pkgbase>-binutils-debug itself (strip+debug options).
# binutils-common carries no host ELF binaries (only lib/bfd-plugins/libdep.so, a
# target .so), so it contributes nothing to the mingw64 -debug package.
pkgname=("msys-cross-${_mct}-binutils")
[ "$_mct" = mingw64 ] && pkgname=("msys-cross-binutils-common" "${pkgname[@]}")
arch=('x86_64')
# strip + debug => small main package + a separate <pkgbase>-debug package carrying
# the split debug symbols (the cross-tool binaries are host Linux ELF, so objcopy
# --only-keep-debug applies normally). Preserve the inherited upstream flags.
options=('strip' 'debug' 'staticlibs' '!distcc' '!ccache' '!buildflags')

# ---- check() — single target only ----
# The inherited upstream check() loops over _targetpkgs (all 3 mingw targets) and
# _check()s each by cd-ing into its binutils-build-<triple> dir. We build only ONE
# target per run, so that loop would cd into a non-existent dir (e.g. ucrt64's) and
# abort. Override it to run the binutils testsuite for just the target we built.
# The inherited _check() helper (cd build dir; make -k check || true) is reused as-is.
check() {
    _check "$_mct_triple"
}

_bintools=(addr2line ar as c++filt dlltool dllwrap elfedit gprof ld ld.bfd
           nm objcopy objdump ranlib readelf size strings strip windmc windres)

# ---- prepare() — MSYS2's 2 patches + our NT weak externals ----
prepare() {
    _msys2_prepare
    cd "${srcdir}/binutils-${pkgver}"
    apply_patch_with_msg "${_our_binutils_patches[@]}"
}

# ---- _build_one — configure, libiberty fix, make ----
_build_one() {
    local target=$1
    _build_dir="${srcdir}/binutils-build-${target}"

    mkdir -p "$_build_dir" && cd "$_build_dir"

    local _conf='--enable-lto'
    if [ "$target" != "i686-w64-mingw32" ]; then
        _conf+=' --enable-64-bit-bfd'
    fi

    # --build/--host come from MSYS_CROSS_BUILD / MSYS_CROSS_HOST (set by
    # env-<target>.sh; e.g. host=aarch64-apple-darwin20 for a macOS-hosted cross
    # binutils). host != build forces configure into cross mode, so it won't try to RUN
    # the (non-native) conftest. The actual output arch is decided by the zig wrapper's
    # target (ZIG_TARGET), independent of these labels.
    # zlib: --with-system-zlib resolves on every host — the system libz on Linux, and
    # the libz.a provisioned into the deps prefix on darwin (build-deps-darwin.sh).
    "${srcdir}/binutils-${pkgver}/configure" \
        --build="$MSYS_CROSS_BUILD" \
        --host="$MSYS_CROSS_HOST" \
        --target="$target" \
        --prefix=/ --disable-werror --with-system-zlib \
        $_conf

    make -j"$(nproc)" all-libiberty
    ln -sf libiberty.a "$_build_dir/libiberty/libiberty.so"
    ln -sf libiberty.a "$_build_dir/libiberty/pic/libiberty.so" 2>/dev/null || true

    make -j"$(nproc)"
}

# ---- build() — single target ($_mct) ----
build() {
    setup_zig_env
    _build_one "$_mct_triple"
}

# ---- _package_one(target, subdir) — install, rearrange, clean ----
_package_one() {
    local target=$1 subdir=$2
    cd "${srcdir}/binutils-build-${target}"
    make DESTDIR="${pkgdir}" install

    # Move <target>/bin/* and <target>/lib/* into MSYS2-layout subdir
    if [ -d "${pkgdir}/${target}" ]; then
        mkdir -p "${pkgdir}/${subdir}"
        for d in "${pkgdir}/${target}/"*; do
            [ -e "$d" ] && mv "$d" "${pkgdir}/${subdir}/"
        done
        rm -rf "${pkgdir}/${target}"
    fi

    # Unprefixed symlinks so GCC finds as/ld/etc. under sysroot
    for tool in "${_bintools[@]}"; do
        rm -f "${pkgdir}/${subdir}/bin/${tool}"
        ln -sf "../../bin/${target}-${tool}" "${pkgdir}/${subdir}/bin/${tool}"
    done

    rm -rf "${pkgdir}/share"
    find "${pkgdir}" -name "*.exe" -delete
    rm -rf "${pkgdir}/lib"
}

package_msys-cross-binutils-common() {
    pkgdesc="Shared files for msys2-cross binutils (BFD plugins)"
    depends=(msys-cross-filesystem)
    cd "${srcdir}/binutils-build-x86_64-w64-mingw32"
    make DESTDIR="${pkgdir}" install
    # Keep only lib/bfd-plugins/libdep.so (target-independent)
    mkdir -p "${pkgdir}-tmp/lib/bfd-plugins"
    mv "${pkgdir}/lib/bfd-plugins/libdep.so" "${pkgdir}-tmp/lib/bfd-plugins/" 2>/dev/null || true
    rm -rf "${pkgdir}/"*
    mkdir -p "$(dirname "${pkgdir}/lib/bfd-plugins/libdep.so")"
    mv "${pkgdir}-tmp/lib/bfd-plugins/libdep.so" "${pkgdir}/lib/bfd-plugins/"
    rm -rf "${pkgdir}-tmp"
}

package_msys-cross-mingw64-binutils() {
    pkgdesc="Cross binutils for x86_64-w64-mingw32 target"
    depends=(msys-cross-filesystem "msys-cross-binutils-common=${pkgver}-${pkgrel}")
    _package_one "x86_64-w64-mingw32" "mingw64"
}

package_msys-cross-mingw32-binutils() {
    pkgdesc="Cross binutils for i686-w64-mingw32 target"
    depends=(msys-cross-filesystem "msys-cross-binutils-common=${pkgver}-${pkgrel}")
    _package_one "i686-w64-mingw32" "mingw32"
}

package_msys-cross-ucrt64-binutils() {
    pkgdesc="Cross binutils for x86_64-w64-mingw32ucrt target"
    depends=(msys-cross-filesystem "msys-cross-binutils-common=${pkgver}-${pkgrel}")
    _package_one "x86_64-w64-mingw32ucrt" "ucrt64"
}

package_msys-cross-cygwin-binutils() {
    pkgdesc="Cross binutils for x86_64-pc-cygwin target"
    depends=(msys-cross-filesystem "msys-cross-binutils-common=${pkgver}-${pkgrel}")
    _package_one "x86_64-pc-cygwin" "usr"
}
