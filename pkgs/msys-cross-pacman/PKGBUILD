# Maintainer: msys2-cross project
_startdir="$(cd "$(dirname "${BASH_SOURCE[0]}")" && pwd)"
source "$_startdir/../../scripts/msys-cross-common.sh"

# Inherit the AUR pacman-static PKGBUILD (deps/pacman-static submodule): its
# source=() / sha512sums / version vars and its prepare()/build()/package() (saved
# as _aur_*). It builds pacman + ~13 static deps (curl, openssl, libarchive,
# gpgme, libseccomp, ...) from source.
inherit_aur "pacman-static"

# ---- Drop the zlib + zstd source downloads (we reuse build_deps' prebuilt libs) ----
# build() below seeds $srcdir/temp/usr with build_deps' static libz.a/libzstd.a and
# awk-removes the AUR build()'s zlib/zstd compile blocks, so the upstream zlib/zstd
# tarballs are downloaded but never used. Worse, the AUR's zlib source is a single
# https://zlib.net/ URL with no mirror fallback, and zlib.net intermittently returns
# HTTP 415 to CI runners — failing the whole package on a download we don't need.
# Rebuild source[]/sha512sums[] in lockstep, skipping the zlib (zlib.net) and zstd
# (facebook/zstd release) entries and their detached-signature siblings (.asc/.sig).
_keep_src=(); _keep_sums=()
for _i in "${!source[@]}"; do
    case "${source[$_i]}" in
        *zlib.net/*|*facebook/zstd/releases/*) ;;   # drop tarball + its .asc/.sig
        *) _keep_src+=("${source[$_i]}"); _keep_sums+=("${sha512sums[$_i]}") ;;
    esac
done
source=("${_keep_src[@]}"); sha512sums=("${_keep_sums[@]}")
unset _i _keep_src _keep_sums

# ---- Package metadata (override the inherited AUR identity) ----
pkgname=msys-cross-pacman
pkgdesc="Static, source-patched pacman (non-root) + wrapper for msys2-cross bootstrap"
_our_pkgrel=1
pkgrel="${pkgrel}.${_our_pkgrel}"   # AUR pkgrel . ours
arch=('x86_64')
depends=('msys-cross-filesystem' 'msys-cross-ca-certificates')
backup=('etc/pacman.d/pacman.conf')
# The from-source build needs these host tools (inherit_aur zeroed the AUR's
# makedepends; the build driver runs makepkg -d so they must be on the host —
# see scripts/build.sh). musl/kernel-headers-musl are NOT needed (zig supplies glibc).
makedepends=('meson' 'cmake' 'gperf' 'git')
# keep AUR !emptydirs/!lto; static binary, don't strip-split. !debug: with !strip the
# binary keeps its debug_info, and without !debug makepkg's default `debug` option
# copies the entire compiled source tree (~2200 files / 80 MB of brotli/openssl/curl/…
# .c) into usr/src/debug — pure bloat for a bootstrap pkg whose payload is 3 files.
options=('!emptydirs' '!lto' '!strip' '!debug')

# ---- Our additions to source[]: 3 pacman source patches + wrapper/conf ----
# Two pacman.conf flavours shipped; package() installs the one matching $CARCH:
# pacman.conf (linux x86_64, [msys-cross]) or pacman-darwin.conf (arm64 macOS host,
# [msys-cross-darwin] → /repo-darwin, Architecture = arm64).
source+=("file://$_startdir/0001-nonroot-allow-install.patch"
         "file://$_startdir/0002-no-extract-owner.patch"
         "file://$_startdir/0003-syshookdir-msys-cross.patch"
         "file://$_startdir/0004-cainfo-from-curl-ca-bundle-env.patch"
         "file://$_startdir/msys-pacman"
         "file://$_startdir/pacman.conf"
         "file://$_startdir/pacman-darwin.conf")
sha512sums+=('SKIP' 'SKIP' 'SKIP' 'SKIP' 'SKIP' 'SKIP' 'SKIP')

# ---- Toolchain: zig cc target gnu.2.11, mostly-static ----
# Re-export AFTER inherit_aur so we override the AUR's top-level CC=musl-gcc /
# LDFLAGS=-static. build() reads ${CC}/${LDFLAGS} at call time, so these win.
setup_zig_env
# setup_zig_env's LDFLAGS pulls in gmp/mpfr/... which pacman's deps don't need;
# reset to a clean default (the AUR build adds its own per-dep -L/-l).
#
# Do NOT force -Wl,-Bdynamic here: pacman's deps (liblzma, libbz2, libz, ...) are
# built static-only (.a, no .so), and a configure-time link test such as
# libarchive's `sizeof(wchar_t)` links a probe with -llzma. zig's linker honours
# -Bdynamic with a no-fallback strategy: it searches ONLY for liblzma.so and aborts
# ("unable to find dynamic system library 'lzma'") instead of falling back to the
# static archive the way GNU ld would. An empty LDFLAGS lets zig resolve each -l<dep>
# to its static .a while still linking the system libc/libm DYNAMICALLY by default
# for the gnu target — i.e. exactly the intended mostly-static (glibc-dynamic) binary.
export LDFLAGS=""
# Make CC a single token usable in the AUR build()'s `sed s|CC=gcc|CC=${CC}|`.
export CC CXX AR RANLIB

# ---- Reuse build_deps' prebuilt zlib/zstd (HARD dependency on deps/install) ----
# pacman would otherwise recompile zlib+zstd that scripts/build_deps.sh already
# built into $_deps. We reuse those instead. In the full build.sh flow build_deps
# runs before this package; a standalone build of msys-cross-pacman MUST run
# scripts/build_deps.sh first. Fail loudly (not mid-build) if they're absent.
_require_builddeps_libs() {
    local missing=0 f
    for f in lib/libz.a lib/libzstd.a lib/pkgconfig/zlib.pc lib/pkgconfig/libzstd.pc \
             include/zlib.h include/zstd.h; do
        [ -e "$_deps/$f" ] || { echo "ERROR: $_deps/$f missing" >&2; missing=1; }
    done
    [ "$missing" -eq 0 ] || {
        echo "ERROR: build_deps zlib/zstd not found — run scripts/build_deps.sh first" >&2
        return 1
    }
}

# ---- prepare(): AUR prepare + our 3 source patches ----
prepare() {
    _aur_prepare
    cd "${srcdir}/pacman"
    for p in 0001-nonroot-allow-install 0002-no-extract-owner 0003-syshookdir-msys-cross \
             0004-cainfo-from-curl-ca-bundle-env; do
        msg2 "Applying ${p}.patch"
        patch -Np1 -i "${srcdir}/${p}.patch"
    done
}

# ---- build(): reuse build_deps zlib/zstd, then the inherited AUR build ----
build() {
    _require_builddeps_libs

    # Seed $srcdir/temp/usr (the dir every AUR dep installs into) with build_deps'
    # zlib/zstd: static libs, headers, and pkg-config files. Consumers find them
    # here exactly as if the AUR had built them (curl via --with-zlib/zstd-*=temp/usr,
    # libarchive/pacman via PKG_CONFIG_PATH=temp/usr/lib/pkgconfig).
    local t="${srcdir}/temp/usr"
    mkdir -p "$t/lib/pkgconfig" "$t/include"
    cp -a "$_deps/lib/libz.a" "$_deps/lib/libzstd.a" "$t/lib/"
    cp -a "$_deps/include/zlib.h" "$_deps/include/zconf.h" "$t/include/"
    cp -a "$_deps/include/zstd.h" "$_deps/include/zdict.h" "$_deps/include/zstd_errors.h" "$t/include/"
    cp -a "$_deps/lib/pkgconfig/zlib.pc" "$_deps/lib/pkgconfig/libzstd.pc" "$t/lib/pkgconfig/"

    # Rewrite the inherited AUR build(). All edits are FULL-PLATFORM (linux + darwin) —
    # they trim deps this project doesn't want anywhere, not just for the macOS host.
    #
    #  (1) awk — drop whole dep build blocks (delimited by the next stanza's
    #      `cd "${srcdir}"/<dep>` / `mkdir` line, stable under `declare -f`):
    #      * zstd + brotli + zlib (one run: `cd zstd` .. `cd openssl`) — zstd/zlib come
    #        from build_deps (seeded above); brotli is dropped outright (see below).
    #      * nghttp2 (`cd nghttp2` .. `cd curl`) — curl's http2.
    #      * libgpg-error + libassuan + gpgme (`cd libgpg-error` .. `cd libseccomp`) — the
    #        GPG stack, used ONLY for package-signature verification. Every repo this pacman
    #        ships (linux + darwin, pacman.conf + pacman-darwin.conf) sets SigLevel = Never,
    #        so gpgme is never exercised; we disable it (-Dgpgme=disabled below) and skip
    #        building all three. On the macOS host these three were also the source of a
    #        zig-Mach-O-linker duplicate-symbol error (___sputc, a <stdio.h> inline emitted
    #        as a non-coalescable weak def) at the final pacman link — dropping them removes
    #        that too.
    #      * libseccomp (`cd libseccomp` .. `mkdir .../pacman`) — Linux-only syscall
    #        sandbox for pacman's download user; this pacman runs UNPRIVILEGED into a
    #        user-owned prefix (non-root gate patched out), so it has no value, and it's
    #        absent on macOS.
    #      brotli + nghttp2 are curl compression/HTTP2 extras: a plain https GET of a
    #      release asset (TLS via openssl) needs neither, so cut them on all platforms.
    #  (2) sed — libarchive CFLAGS fix (re-add -O2 -fno-sanitize=undefined; zig cc defaults
    #      -fsanitize=undefined on, which the bare AUR CFLAGS override would otherwise leave
    #      at -O0 and pull 600+ __ubsan_* into the static link).
    #  (3) sed — drop brotli from BOTH openssl (the curl-static patch links brotli into
    #      openssl) and curl configure, and tell curl --without-nghttp2; force pacman's
    #      file-seccomp AND gpgme meson features off (don't rely on auto-detect, which would
    #      otherwise pick up the host's libseccomp/gpgme .pc on the Arch builder).
    eval "$(declare -f _aur_build \
        | awk '
            /cd "\$\{srcdir\}"\/zstd-\$\{_zstdver\}\/lib;/ { skip=1 }   # zstd+brotli+zlib run
            /cd "\$\{srcdir\}"\/openssl-\$\{_sslver\};/    { skip=0 }   # ends at openssl build
            /cd "\$\{srcdir\}"\/nghttp2-\$\{_nghttp2_ver\};/ { skip=1 } # nghttp2 (curl http2)
            /cd "\$\{srcdir\}"\/curl-\$\{_curlver\};/      { skip=0 }
            /cd "\$\{srcdir\}"\/libgpg-error-\$\{_gpgerrorver\};/ { skip=1 } # gpg-error+assuan+gpgme
            /cd "\$\{srcdir\}\/libseccomp";/               { skip=1 } # seccomp sandbox (and ends gpg run)
            /mkdir -p "\$\{srcdir\}"\/pacman;/             { skip=0 }
            skip==0 { print }
          ' \
        | sed 's|CFLAGS="-L${srcdir}/temp/usr/lib"|CFLAGS="-L${srcdir}/temp/usr/lib -O2 -fno-sanitize=undefined"|' \
        | sed -E 's@[[:space:]]*--with-brotli-(include|lib)="\$\{srcdir\}"/temp/usr/(include|lib)@@g' \
        | sed -E 's@ enable-brotli @ @; s@ --with-brotli @ --without-nghttp2 @' \
        | sed 's|-Dscriptlet-shell=/usr/bin/bash|-Dscriptlet-shell=/bin/bash -Dfile-seccomp=disabled -Dgpgme=disabled|')"

    # Guard: if a future AUR bump moves the anchors, the awk silently stops removing the
    # blocks — assert each is actually gone so we fail loudly rather than silently
    # recompiling (or linking brotli/nghttp2/seccomp/gpgme back in).
    if declare -f _aur_build | grep -qE 'make libzstd\.a|make libz\.a|cd "\$\{srcdir\}/libseccomp"|cd "\$\{srcdir\}"/brotli|cd "\$\{srcdir\}"/nghttp2|cd "\$\{srcdir\}"/libgpg-error-|cd "\$\{srcdir\}"/libassuan-|cd "\$\{srcdir\}"/gpgme-|enable-brotli|--with-brotli'; then
        echo "ERROR: AUR zstd/zlib/brotli/nghttp2/seccomp/gpgme blocks not neutralized — anchors changed?" >&2
        return 1
    fi

    # ---- pkg-config: add this build's temp/usr prefix on top of the global confinement ----
    # setup_zig_env (called at top level above) already set PKG_CONFIG_LIBDIR=$_deps/lib/pkgconfig
    # for every build, REPLACING the system search base so no autoconf/meson/cmake probe sees a
    # host .pc — that is what defeats pacman's hardwired dependency('libseccomp') (it would else
    # find the Arch builder's libseccomp.pc → set HAVE_LIBSECCOMP → sandbox_syscalls.c #includes
    # <seccomp.h>, absent from the zig sysroot → fatal). Here we only PREPEND this package's own
    # temp/usr prefix (where build() seeds zlib/zstd and the AUR deps install) — which only
    # exists inside makepkg's build() so it can't live in setup_zig_env. Prepend, don't redefine,
    # so the global system-confinement is preserved.
    export PKG_CONFIG_LIBDIR="${srcdir}/temp/usr/lib/pkgconfig:${PKG_CONFIG_LIBDIR}"

    # ---- macOS host (arm64) cross overrides ----
    # When building for a darwin host (CARCH=arm64, set by makepkg-darwin-arm64.conf), the
    # deps cross-compile under zig with a few adjustments (verified standalone; see
    # docs/.../2026-06-02-darwin-pacman-cross-probe.md). All but two are autoconf cache
    # variables — exported here, since autoconf reads ac_cv_* straight from the environment,
    # so no configure-line surgery is needed for them. (AR=zig ar --format=darwin is handled
    # in setup_zig_env.)
    if [ "${CARCH}" = "arm64" ]; then
        # Put EVERY autoconf configure in _aur_build (xz, bzip2, openssl, libarchive, curl)
        # into cross mode in one shot: autoconf reads build_alias/host_alias from the env as
        # the equivalent of --build/--host. Without this each dep's bare `./configure` (the
        # AUR's native-build form) tries to RUN an arm64 conftest on the Linux builder and
        # dies ("cannot run C compiled programs, use --host"). host != build → cross_compiling=yes.
        export build_alias=x86_64-pc-linux-gnu host_alias=aarch64-apple-darwin20
        # (PKG_CONFIG_LIBDIR confining pkg-config to our prefixes — needed to defeat meson's
        # libseccomp auto-probe — is now set for ALL platforms just above the arm64 block.)
        # libarchive: its autoconf link-tests for these wchar funcs misfire under zig+darwin
        # (macOS HAS them), so it would declare static fallbacks that clash with the SDK's
        # non-static decls. Tell configure they exist.
        export ac_cv_func_wcscpy=yes ac_cv_func_wcslen=yes ac_cv_func_wcscmp=yes \
               ac_cv_func_wcrtomb=yes ac_cv_func_wctomb=yes \
               ac_cv_func_wmemcmp=yes ac_cv_func_wmemcpy=yes ac_cv_func_wmemmove=yes
        # libarchive: zig's macOS SDK has no <membership.h>, so don't select the darwin disk
        # ACL backend (archive_disk_acl_darwin.c). pacman needs no disk ACLs.
        export ac_cv_header_membership_h=no ac_cv_func_mbr_uid_to_uuid=no \
               ac_cv_func_mbr_uuid_to_id=no ac_cv_have_decl_ACL_TYPE_EXTENDED=no \
               ac_cv_have_decl_ACL_TYPE_NFS4=no
        # libarchive_fe (its always-built noinst convenience lib): passphrase.c is broken
        # for "function present, header absent" — macOS libSystem HAS readpassphrase() so
        # configure sets HAVE_READPASSPHRASE=1, but zig's SDK ships no <readpassphrase.h> so
        # HAVE_READPASSPHRASE_H is unset → neither the system prototype nor the bundled
        # fallback (guarded by #ifndef HAVE_READPASSPHRASE) is compiled, leaving the call
        # undeclared and RPP_ECHO_OFF undefined. Force the func "absent" so libarchive uses
        # its own bundled OpenBSD readpassphrase.c + RPP_* macros (the Linux path). pacman
        # never prompts for a passphrase in our flow; the bundled impl is correct regardless.
        export ac_cv_func_readpassphrase=no
        # curl: macOS pthread is in libSystem, not -lpthread (autoconf misses it).
        export ac_cv_func_pthread_create=yes
        # pacman itself is built with meson, which — unlike autoconf — does NOT honour
        # build_alias/host_alias; left to itself it compiles an arm64 Mach-O sanity-check
        # exe and tries to RUN it on the Linux builder ("binary or interpreter not
        # executable. Possibly wrong architecture"). A meson cross file declares the host
        # machine + the zig wrapper toolchain so meson knows it's cross-compiling and skips
        # running built executables. The compilers/ar are exactly what setup_zig_env exports
        # (CC/CXX wrappers under scripts/, AR=zig ar --format=darwin for Mach-O archives).
        # We also pass -Di18n=false to the pacman meson run: i18n=true pulls dependency('intl')
        # (libintl), which on macOS is a separate gettext lib zig's SDK does not ship (on
        # Linux it's builtin to glibc). A bootstrap pacman needs no message translation.
        _meson_cross="${srcdir}/meson-cross-darwin.txt"
        cat > "$_meson_cross" <<EOF
[binaries]
c = '${CC}'
cpp = '${CXX}'
ar = ['zig', 'ar', '--format=darwin']
strip = ['zig', 'strip']
ranlib = ['zig', 'ranlib']
pkg-config = 'pkg-config'

[host_machine]
system = 'darwin'
cpu_family = 'aarch64'
cpu = 'aarch64'
endian = 'little'
EOF
        # Two configure-line edits (not cache vars) + the meson cross/i18n injection:
        #  - openssl's CARCH case has no arm64 arm → add the darwin64-arm64-cc target.
        #  - curl: turn IPV6 OFF by editing the AUR's own --enable-{ipv6,threaded-resolver}
        #    brace expansion → --enable-threaded-resolver --disable-ipv6. (Just APPENDING
        #    --disable-ipv6 elsewhere on the line does NOT work: curl 8.20's configure lets
        #    the earlier --enable-ipv6 win, leaving USE_IPV6 defined.) With USE_IPV6 unset,
        #    curl_setup.h no longer defines CURL_MACOS_CALL_COPYPROXIES, so macos.c — which
        #    #includes <SystemConfiguration/...> that zig's macOS SDK lacks — is excluded.
        #    macOS still resolves hosts via getaddrinfo; only the system DNS/proxy-pref read
        #    (a SCDynamicStore call) is skipped, irrelevant to a plain https GET.
        #  - pacman meson: --cross-file (so meson cross-compiles, see above) + -Di18n=false
        #    (no libintl on macOS, see above). -Dgpgme/-Dfile-seccomp are already disabled by
        #    the full-platform sed; the gpg/seccomp dep blocks are dropped by the awk above.
        eval "$(declare -f _aur_build \
            | sed 's@\([[:space:]]*\)x86_64)@\1arm64)\n\1    openssltarget=darwin64-arm64-cc\n\1    optflags=;;\n\1x86_64)@' \
            | sed 's@--enable-{ipv6,threaded-resolver}@--enable-threaded-resolver --disable-ipv6@' \
            | sed "s@meson --prefix=/usr@meson --cross-file $_meson_cross -Di18n=false --prefix=/usr@")"
    fi

    _aur_build
}

# ---- check(): behavioural assertions on the source-patched binary (non-root) ----
check() {
    [ "$(id -u)" -ne 0 ] || { echo "check(): refusing to validate as root"; return 1; }
    local bin="${srcdir}/pacman/build/pacman"
    [ -x "$bin" ] || bin="${srcdir}/pacman/build/src/pacman/pacman"
    [ -x "$bin" ] || { echo "check(): pacman binary not found under build/"; return 1; }

    # Non-root gate removed: a real -Sy must NOT print the root error.
    local root="${srcdir}/_checkroot"
    rm -rf "$root"; mkdir -p "$root/var/lib/pacman"
    cat > "$root/pacman.conf" <<'EOF'
[options]
Architecture = x86_64
SigLevel = Never
[core]
Server = https://geo.mirror.pkgbuild.com/$repo/os/$arch
EOF
    local out
    out=$("$bin" --root "$root" --config "$root/pacman.conf" \
        --dbpath "$root/var/lib/pacman" --noconfirm -Sy 2>&1) || true
    echo "$out"
    if grep -qi 'unless you are root' <<<"$out"; then
        echo "check(): FAILED — non-root gate still present" >&2; return 1
    fi
    echo "check(): OK — non-root gate removed"

    # No-chown: the source must no longer OR ARCHIVE_EXTRACT_OWNER into the libarchive
    # extract bitmask. Match only the OPERATIVE form (the flag adjacent to a '|' in the
    # archive_flags expression), not the bare word — 0002-no-extract-owner.patch leaves
    # an explanatory comment that mentions "ARCHIVE_EXTRACT_OWNER" in prose, and a bare
    # `grep -q ARCHIVE_EXTRACT_OWNER` would false-positive on that comment.
    if grep -qE '(ARCHIVE_EXTRACT_OWNER[[:space:]]*\||\|[[:space:]]*ARCHIVE_EXTRACT_OWNER)' \
            "${srcdir}/pacman/lib/libalpm/add.c"; then
        echo "check(): FAILED — ARCHIVE_EXTRACT_OWNER still OR'd into archive_flags in add.c" >&2; return 1
    fi
    echo "check(): OK — extract-owner flag removed"

    # Hook dir redirected: binary must reference msys-cross-hooks, not the bare hooks dir.
    if ! strings "$bin" | grep -qF 'libalpm/msys-cross-hooks/'; then
        echo "check(): FAILED — msys-cross-hooks not in binary" >&2; return 1
    fi
    if strings "$bin" | grep -qE 'libalpm/hooks/$'; then
        echo "check(): FAILED — original system hook dir still present" >&2; return 1
    fi
    echo "check(): OK — system hook dir redirected to msys-cross-hooks"

    # CAINFO from CURL_CA_BUNDLE: libcurl bakes the CA bundle path at build time and
    # (unlike curl(1)) ignores CURL_CA_BUNDLE, so without 0004 the trust store can't be
    # redirected to the relocatable in-prefix bundle — fatal on macOS, which has no
    # /etc/ssl/...crt. Assert the patch is COMPILED INTO the binary (not merely applied
    # to the source): the "CURL_CA_BUNDLE" getenv() literal lands in rodata and is absent
    # from stock pacman/libcurl (libcurl uses the name only in the curl(1) tool, and
    # libalpm never referenced it). Works for BOTH the native x86_64 and the arm64 cross
    # binary, neither of which we can necessarily run here.
    if ! strings "$bin" | grep -qF 'CURL_CA_BUNDLE'; then
        echo "check(): FAILED — CURL_CA_BUNDLE not in binary (0004 not compiled in?)" >&2; return 1
    fi
    echo "check(): OK — binary honours CURL_CA_BUNDLE (literal present → CURLOPT_CAINFO wired)"

    # Then, for the NATIVE (runnable) build only, prove it at runtime: point
    # CURL_CA_BUNDLE at a bogus path and confirm pacman's TLS error now names THAT path
    # (env reached libcurl) rather than the compiled-in /etc/ssl default. This is the
    # exact failure the macOS user hit, run in reverse as a positive control.
    if [ "${CARCH}" != "arm64" ]; then
        local out2 bogus="${srcdir}/_no_such_ca_bundle.crt"
        rm -f "$bogus"
        out2=$(CURL_CA_BUNDLE="$bogus" "$bin" --root "$root" --config "$root/pacman.conf" \
            --dbpath "$root/var/lib/pacman" --noconfirm -Sy 2>&1) || true
        if ! grep -qF "$bogus" <<<"$out2"; then
            echo "check(): FAILED — CURL_CA_BUNDLE not honoured by libcurl; error did not name $bogus" >&2
            echo "$out2" >&2; return 1
        fi
        echo "check(): OK — CURL_CA_BUNDLE reaches libcurl (TLS error named the override path)"
    fi
}

# ---- package(): extract ONLY the pacman-static binary + wrapper + conf ----
package() {
    # The AUR build leaves the linked binary at pacman/build/src/pacman/pacman.
    local _pac="${srcdir}/pacman/build/src/pacman/pacman"
    [ -x "$_pac" ] || _pac="${srcdir}/pacman/build/pacman"

    install -Dm755 "$_pac"                       "$pkgdir/libexec/pacman-static"
    install -Dm755 "$srcdir/msys-pacman"         "$pkgdir/bin/msys-pacman"
    # Ship the pacman.conf matching the host arch: arm64 macOS host gets the darwin conf
    # ([msys-cross-darwin] → /repo-darwin, Architecture = arm64), baked in so the user
    # never edits it; everything else gets the linux x86_64 conf. CARCH comes from the
    # makepkg config (makepkg-darwin-arm64.conf sets CARCH=arm64).
    local _conf="$srcdir/pacman.conf"
    [ "${CARCH}" = "arm64" ] && _conf="$srcdir/pacman-darwin.conf"
    install -Dm644 "$_conf"                      "$pkgdir/etc/pacman.d/pacman.conf"
}
