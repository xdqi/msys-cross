# Maintainer: msys2-cross project
_startdir="$(cd "$(dirname "${BASH_SOURCE[0]}")" && pwd)"
source "$_startdir/../../scripts/msys-cross-common.sh"
source "$_startdir/../../scripts/extract-target-libs.sh"
inherit_msys2 "mingw-w64-cross-gcc"

# ---- Fix _build() to match build_gcc.sh configure line-for-line ----
# Uses _stage_prefix variable (set in build()) instead of hardcoded prefix,
# so we can create per-target sysroot symlinks under it (like build_gcc.sh NEWBIN).
eval "$(declare -f _build | sed \
    -e 's|--prefix=/opt|--prefix="${_stage_prefix}"|g' \
    -e 's|--libexecdir=/opt/lib|--libexecdir="${_stage_prefix}/libexec"|g' \
    -e 's|\${CHOST}|x86_64-linux-gnu|g' \
    -e 's|--with-{gmp,mpfr,mpc,isl}=/usr|--with-gmp='"$_deps"' --with-mpfr='"$_deps"' --with-mpc='"$_deps"' --with-isl='"$_deps"'|g' \
    -e 's|--enable-libgomp|--disable-libcc1 --enable-libgomp|g' \
    -e 's| fortran|,fortran|g' \
    -e '/export lt_cv_deplibs_check_method/d' \
    -e 's|CFLAGS="-O2 -pipe"|CFLAGS="-O2 -I'"$_deps"'/include -fbracket-depth=512 -Wno-error '"$_ZIG_QUIET_FLAGS"'"|g' \
    -e 's|CXXFLAGS="-O2 -pipe"|CXXFLAGS="-O2 -I'"$_deps"'/include -fbracket-depth=512 -Wno-error '"$_ZIG_QUIET_FLAGS"'"|g' \
    -e 's|--enable-version-specific-runtime-libs|--disable-version-specific-runtime-libs --with-pkgversion="msys2-cross ${pkgver}-${pkgrel}" --with-bugurl="https://github.com/xdqi/msys-cross/issues"|g' \
    -e 's|--enable-threads=\${_threads}|--enable-threads=posix|g' \
    -e 's|\bmake all\b|make -j"$(nproc)" all-gcc|g')"

# ---- Package metadata ----
_our_pkgrel=1
pkgrel="${_msys2_pkgrel}.${_our_pkgrel}"

# Override the inherited upstream pkgbase (mingw-w64-cross-gcc) so the split
# debug package is named msys-cross-gcc-debug, not mingw-w64-cross-gcc-debug.
pkgbase=msys-cross-gcc
pkgname=(
    msys-cross-mingw64-gcc
    msys-cross-mingw64-gcc-fortran
    msys-cross-mingw32-gcc
    msys-cross-mingw32-gcc-fortran
    msys-cross-ucrt64-gcc
    msys-cross-ucrt64-gcc-fortran
)
arch=('x86_64')
# strip + debug => small main packages + a separate *-debug package carrying the
# split debug symbols (the cross-gcc binaries are host Linux ELF, so objcopy
# --only-keep-debug applies normally). Preserve the inherited upstream flags.
options=('strip' 'debug' 'staticlibs' '!emptydirs' '!buildflags')

# ---- Extra chimera patches ----
_chimera_patches=(
    clang-tree-vect.patch
    0010-Don-t-declare-asprintf-if-defined-as-a-macro.patch
    0011-libiberty-copy-PIC-objects-during-build-process.patch
    0015-build-fix-CXXFLAGS_FOR_BUILD-passing.patch
)
for p in "${_chimera_patches[@]}"; do
    source+=("file://$_startdir/$p")
    sha256sums+=('SKIP')
done

# ---- Target runtime libs come from the build sysroot (no download here) ----
# msys-cross-gcc builds ONLY the host compiler (make all-gcc). The TARGET runtime
# libraries (libgcc/crt, libstdc++, libgfortran, C++ headers, finclude .mod) are
# supplied by the upstream MSYS2 gcc + gcc-fortran packages that
# prepare-build-sysroot.sh installs into the build sysroot via pacman. The package
# functions below COPY those files out of the sysroot (copy_sysroot_pkg, using
# `pacman -Ql`), so pacman resolves the correct per-target version/triple/layout
# and no source URLs / sha256 pins / version quirks are needed here.

# ---- Override: make patching tolerant (a patch may already be partly applied) ----
apply_patch_with_msg() {
    for _fname in "$@"; do
        msg2 "Applying ${_fname}"
        patch -Nbp1 -i "${srcdir}"/${_fname} || true
    done
}

# ---- prepare() — MSYS2's + chimera ----
prepare() {
    _msys2_prepare
    cd "${srcdir}/${_realname}-${pkgver}"
    apply_patch_with_msg "${_chimera_patches[@]}"
}

# ---- build() — set up stage prefix (like build_gcc.sh NEWBIN), then MSYS2 loop ----
build() {
    setup_zig_env

    # Stage prefix: like build_gcc.sh $NEWBIN — a writable directory where we
    # create <target> → MSYS2 sysroot symlinks before make.
    _stage_prefix="${srcdir}/stage"
    mkdir -p "$_stage_prefix"

    # Per-target sysroot symlinks (xgcc needs headers/CRT for target libs)
    for _t in x86_64-w64-mingw32 i686-w64-mingw32 x86_64-w64-mingw32ucrt; do
        case "$_t" in
            x86_64-w64-mingw32ucrt) _sub=ucrt64 ;;
            i686*)                  _sub=mingw32 ;;
            x86_64*)                _sub=mingw64 ;;
        esac
        rm -rf "$_stage_prefix/$_t"
        ln -sf "$_bootstrap_prefix/$_sub" "$_stage_prefix/$_t"
    done

    _msys2_build
}

# ---- _package_one — install + cleanup ----
# Like build_gcc.sh, we configured with a staging prefix. DESTDIR install
# puts files at ${pkgdir}${_stage_prefix}/... — move them to ${pkgdir}/.
_package_one() {
    local target=$1
    cd "${srcdir}/gcc-build-${target}"
    # C/C++ only. "install-common" pulls in lang.install-common
    # (c/c++/fortran/lto.install-common) which would also install the gfortran
    # driver — that belongs in the separate -gcc-fortran subpackage. Use
    # "c++.install-common" instead: it installs g++/c++ (and cc1plus); the C
    # driver (gcc/xgcc) comes from "install-driver", which is in the list below.
    # The cc1/cc1plus/lto1/collect2 backends are installed by the explicit loop
    # further down (COMPILERS would also place them via install-common, but we
    # drop install-common to keep Fortran out).
    make -C gcc -j1 DESTDIR="${pkgdir}" \
        c++.install-common install-driver install-cpp install-gcc-ar \
        install-headers install-plugin install-lto-wrapper

    # Resolve the staged install prefix the same way the move below does, so the
    # backend-binary backstop lands in the SAME staged libexec the move drains
    # (not at the package root) regardless of whether _stage_prefix is exported
    # in this shell — keeps full builds and `makepkg -R` repackages consistent.
    local _pfx="${_stage_prefix:-${srcdir}/stage}"
    local _staged="${pkgdir}${_pfx}"
    for b in cc1 cc1plus collect2 lto1 lto-wrapper; do
        [ -f "gcc/$b" ] && install -Dm755 "gcc/$b" "${_staged}/libexec/gcc/${target}/${pkgver}/$b" || true
    done
    # The host LTO linker plugin (liblto_plugin.so) is built by "make all-gcc"
    # under lto-plugin/.libs/, but "make -C gcc install-*" never installs it.
    # The default specs pass -fuse-linker-plugin, so the driver refuses to run
    # without it. Install it into the same versioned libexec dir gcc searches.
    for _lto in lto-plugin/.libs/liblto_plugin.so gcc/liblto_plugin.so; do
        if [ -f "$_lto" ]; then
            install -Dm755 "$_lto" "${_staged}/libexec/gcc/${target}/${pkgver}/liblto_plugin.so"
            break
        fi
    done

    if [ -d "$_staged" ]; then
        for _d in bin lib libexec share; do
            [ -e "$_staged/$_d" ] && mv "$_staged/$_d" "${pkgdir}/"
        done
        # Target libs (libstdc++, libgcc_s, crt, etc.) come from MSYS2 native packages
        rm -rf "$_staged/$target"
        # Remove the empty stage prefix hierarchy (pkgdir/home/...)
        rm -rf "${pkgdir}/home"
    fi

    rm -rf "${pkgdir}/share"
    find "${pkgdir}" -name "*.exe" -delete
}

# ---- _package_one_fortran — gfortran driver + f951 backend (host) + libgfortran ----
# Fortran subpackage: gfortran driver + f951 backend (host) + libgfortran (target,
# copied from the build sysroot). Split out so users who don't need Fortran install
# only the smaller -gcc package. Mirrors upstream native package_gcc-fortran():
# fortran.install-common installs the gfortran driver; f951 is installed by hand
# (the build Makefile only installs it via install-common's COMPILERS loop, which
# we deliberately don't run here); libgfortran.a/.dll.a/.spec + finclude .mod
# files come from the upstream mingw-w64-<arch>-gcc-fortran package that
# prepare-build-sysroot.sh installed into the build sysroot.
# Args: <our-target-triple> <upstream-pkgname> <sysroot-subdir>
#   * <our-target-triple>  — the triple our host gcc was configured with
#     (x86_64-w64-mingw32 / i686-w64-mingw32 / x86_64-w64-mingw32ucrt); names the
#     build dir and the host f951 dest.
#   * <upstream-pkgname>   — mingw-w64-<arch>-gcc-fortran (whatever pacman resolved
#     in the sysroot; copy_sysroot_pkg copies its files verbatim).
#   * <sysroot-subdir>     — mingw64/mingw32/ucrt64 (the installed filesystem
#     symlink target the cross-gcc search path resolves <target> to).
_package_one_fortran() {
    local target=$1 fpkg=$2 subdir=$3
    cd "${srcdir}/gcc-build-${target}"
    make -C gcc -j1 DESTDIR="${pkgdir}" fortran.install-common
    local _pfx="${_stage_prefix:-${srcdir}/stage}"
    local _staged="${pkgdir}${_pfx}"
    # f951 backend binary (host)
    [ -f "gcc/f951" ] && install -Dm755 "gcc/f951" "${_staged}/libexec/gcc/${target}/${pkgver}/f951"
    if [ -d "$_staged" ]; then
        # Move (not copy) the staged host bits to the package root. The -gcc and
        # -gcc-fortran packages build from the SAME build dir but install disjoint
        # files (c++.install-common vs fortran.install-common have no overlap),
        # so a plain mv is safe and avoids any cross-package file claim.
        for _d in bin lib libexec share; do
            [ -e "$_staged/$_d" ] && mv "$_staged/$_d" "${pkgdir}/"
        done
        rm -rf "$_staged/$target" "${pkgdir}/home"
    fi
    rm -rf "${pkgdir}/share"
    find "${pkgdir}" -name "*.exe" -delete
    # libgfortran.a/.dll.a/.spec + finclude/.mod + libcaf_*.a: copy the upstream
    # gcc-fortran package's files out of the sysroot (pacman -Ql); pacman already
    # resolved the right version/triple/layout, so no relocation is needed.
    copy_sysroot_pkg "$_bootstrap_prefix" "$fpkg" "$pkgdir"
}

package_msys-cross-mingw64-gcc() {
    pkgdesc="Cross GCC for x86_64-w64-mingw32 target (gcc/g++)"
    depends=(msys-cross-filesystem msys-cross-mingw64-binutils
             mingw-w64-x86_64-headers mingw-w64-x86_64-crt
             mingw-w64-x86_64-winpthreads mingw-w64-x86_64-gcc-libs
             mingw-w64-x86_64-zlib mingw-w64-x86_64-windows-default-manifest)
    _package_one "x86_64-w64-mingw32"
    # Target libs (libgcc/crt, libstdc++, C++ headers) come from the upstream
    # mingw-w64-x86_64-gcc package installed in the build sysroot. They land under
    # the MSYS2 sysroot subdir (mingw64), which the filesystem package's
    # "x86_64-w64-mingw32 -> mingw64" symlink resolves the cross-gcc search path to.
    copy_sysroot_pkg "$_bootstrap_prefix" "mingw-w64-x86_64-gcc" "$pkgdir"
}

package_msys-cross-mingw64-gcc-fortran() {
    pkgdesc="Cross GFortran for x86_64-w64-mingw32 target"
    depends=(msys-cross-mingw64-gcc mingw-w64-x86_64-gcc-libs)
    _package_one_fortran "x86_64-w64-mingw32" "mingw-w64-x86_64-gcc-fortran-16.1.0-1-any.pkg.tar.zst" "mingw64"
}

package_msys-cross-mingw32-gcc() {
    pkgdesc="Cross GCC for i686-w64-mingw32 target (gcc/g++)"
    depends=(msys-cross-filesystem msys-cross-mingw32-binutils
             mingw-w64-i686-headers mingw-w64-i686-crt
             mingw-w64-i686-winpthreads mingw-w64-i686-gcc-libs
             mingw-w64-i686-zlib mingw-w64-i686-windows-default-manifest)
    _package_one "i686-w64-mingw32"
    # C/C++ target libs from the upstream mingw-w64-i686-gcc package in the sysroot.
    copy_sysroot_pkg "$_bootstrap_prefix" "mingw-w64-i686-gcc" "$pkgdir"
}

package_msys-cross-mingw32-gcc-fortran() {
    pkgdesc="Cross GFortran for i686-w64-mingw32 target"
    depends=(msys-cross-mingw32-gcc mingw-w64-i686-gcc-libs)
    # libgfortran from the upstream mingw-w64-i686-gcc-fortran package in the
    # sysroot. pacman may have resolved an older version (e.g. 15.2.0) for i686;
    # we copy whatever it installed verbatim — the .mod module format and
    # libgfortran SONAME are stable across recent GCC majors.
    _package_one_fortran "i686-w64-mingw32" \
        "mingw-w64-i686-gcc-fortran" "mingw32"
}

package_msys-cross-ucrt64-gcc() {
    pkgdesc="Cross GCC for x86_64-w64-mingw32ucrt target (gcc/g++)"
    depends=(msys-cross-filesystem msys-cross-ucrt64-binutils
             mingw-w64-ucrt-x86_64-headers mingw-w64-ucrt-x86_64-crt
             mingw-w64-ucrt-x86_64-winpthreads mingw-w64-ucrt-x86_64-gcc-libs
             mingw-w64-ucrt-x86_64-zlib mingw-w64-ucrt-x86_64-windows-default-manifest)
    _package_one "x86_64-w64-mingw32ucrt"
    # C/C++ target libs from the upstream mingw-w64-ucrt-x86_64-gcc package in the
    # sysroot. They land under ucrt64/, which the filesystem package's
    # "x86_64-w64-mingw32ucrt -> ucrt64" symlink resolves the search path to.
    copy_sysroot_pkg "$_bootstrap_prefix" "mingw-w64-ucrt-x86_64-gcc" "$pkgdir"
    # Triple fixup (ucrt64 only): our host gcc is configured
    # --target=x86_64-w64-mingw32ucrt and searches lib/gcc/x86_64-w64-mingw32ucrt/,
    # but upstream MSYS2 builds the ucrt gcc-internal bits under the PLAIN triple
    # x86_64-w64-mingw32. Symlink the configured triple to the plain one so the
    # driver finds libgcc/crt (minimal, in-place; no file relocation).
    _ucrt_relink_triple "$pkgdir/ucrt64"
}

# ---- _ucrt_relink_triple — point the configured ucrt triple at the upstream one ----
# Idempotent: only creates a symlink when the configured-triple dir is missing and
# the plain-triple dir exists (no-op otherwise). Covers both gcc-internal layouts:
#   lib/gcc/<triple>/<ver>/...  and  include/c++/<ver>/<triple>/...
_ucrt_relink_triple() {
    local base=$1 plain=x86_64-w64-mingw32 ours=x86_64-w64-mingw32ucrt
    # lib/gcc/<triple>
    if [ -d "$base/lib/gcc/$plain" ] && [ ! -e "$base/lib/gcc/$ours" ]; then
        ln -sf "$plain" "$base/lib/gcc/$ours"
    fi
    # include/c++/<ver>/<triple>  (per-version config header dir)
    local v
    for v in "$base"/include/c++/*; do
        [ -d "$v/$plain" ] && [ ! -e "$v/$ours" ] && ln -sf "$plain" "$v/$ours"
    done
}

package_msys-cross-ucrt64-gcc-fortran() {
    pkgdesc="Cross GFortran for x86_64-w64-mingw32ucrt target"
    depends=(msys-cross-ucrt64-gcc mingw-w64-ucrt-x86_64-gcc-libs)
    # libgfortran from the upstream mingw-w64-ucrt-x86_64-gcc-fortran package in the
    # sysroot. The libgfortran .a/.mod live under ucrt64/lib (triple-independent),
    # reached via the symlink; the configured-triple finclude dir is already linked
    # by _ucrt_relink_triple in the -gcc package.
    _package_one_fortran "x86_64-w64-mingw32ucrt" \
        "mingw-w64-ucrt-x86_64-gcc-fortran" "ucrt64"
}
