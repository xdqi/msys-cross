# Maintainer: msys2-cross project
_startdir="$(cd "$(dirname "${BASH_SOURCE[0]}")" && pwd)"
source "$_startdir/../../scripts/msys-cross-common.sh"
source "$_startdir/../../scripts/extract-target-libs.sh"
inherit_msys2 "mingw-w64-cross-gcc"

# ---- Fix _build() to match build_gcc.sh configure line-for-line ----
# Uses _stage_prefix variable (set in build()) instead of hardcoded prefix,
# so we can create per-target sysroot symlinks under it (like build_gcc.sh NEWBIN).
eval "$(declare -f _build | sed \
    -e 's|--prefix=/opt|--prefix="${_stage_prefix}"|g' \
    -e 's|--libexecdir=/opt/lib|--libexecdir="${_stage_prefix}/libexec"|g' \
    -e 's|\${CHOST}|x86_64-linux-gnu|g' \
    -e 's|--with-{gmp,mpfr,mpc,isl}=/usr|--with-gmp='"$_deps"' --with-mpfr='"$_deps"' --with-mpc='"$_deps"' --with-isl='"$_deps"'|g' \
    -e 's|--enable-libgomp|--disable-libcc1 --enable-libgomp|g' \
    -e 's| fortran|,fortran|g' \
    -e '/export lt_cv_deplibs_check_method/d' \
    -e 's|CFLAGS="-O2 -pipe"|CFLAGS="-O2 -I'"$_deps"'/include -fbracket-depth=512 -Wno-error"|g' \
    -e 's|CXXFLAGS="-O2 -pipe"|CXXFLAGS="-O2 -I'"$_deps"'/include -fbracket-depth=512 -Wno-error"|g' \
    -e 's|--enable-version-specific-runtime-libs|--disable-version-specific-runtime-libs --with-pkgversion="msys2-cross ${pkgver}-${pkgrel}" --with-bugurl="https://github.com/xdqi/msys-cross/issues"|g' \
    -e 's|--enable-threads=\${_threads}|--enable-threads=posix|g' \
    -e 's|\bmake all\b|make -j"$(nproc)" all-gcc|g')"

# ---- Package metadata ----
_our_pkgrel=1
pkgrel="${_msys2_pkgrel}.${_our_pkgrel}"

# Override the inherited upstream pkgbase (mingw-w64-cross-gcc) so the split
# debug package is named msys-cross-gcc-debug, not mingw-w64-cross-gcc-debug.
pkgbase=msys-cross-gcc
pkgname=(
    msys-cross-mingw64-gcc
    msys-cross-mingw64-gcc-fortran
    msys-cross-mingw32-gcc
    msys-cross-mingw32-gcc-fortran
    msys-cross-ucrt64-gcc
    msys-cross-ucrt64-gcc-fortran
)
arch=('x86_64')
# strip + debug => small main packages + a separate *-debug package carrying the
# split debug symbols (the cross-gcc binaries are host Linux ELF, so objcopy
# --only-keep-debug applies normally). Preserve the inherited upstream flags.
options=('strip' 'debug' 'staticlibs' '!emptydirs' '!buildflags')

# ---- Extra chimera patches ----
_chimera_patches=(
    clang-tree-vect.patch
    0010-Don-t-declare-asprintf-if-defined-as-a-macro.patch
    0011-libiberty-copy-PIC-objects-during-build-process.patch
    0015-build-fix-CXXFLAGS_FOR_BUILD-passing.patch
)
for p in "${_chimera_patches[@]}"; do
    source+=("file://$_startdir/$p")
    sha256sums+=('SKIP')
done

# ---- Upstream MSYS2 target runtime libs (all 3 mingw targets) ----
# Instead of compiling libgcc/libstdc++/libgfortran/crt with the freshly-built
# xgcc (make all-target...), we build only the host compiler (make all-gcc) and
# bundle the version-matched runtime libs extracted from the upstream MSYS2
# binary packages. PIN these external binaries (the rest of the project SKIPs).
#
# Version note: the C/C++ gcc base packages are all gcc-16.1.0-5 (matches our
# pkgver=16.1.0). gcc-fortran is 16.1.0-1 for mingw64 and ucrt64, but MSYS2 has
# NOT published a gcc-fortran 16.1.0 for the 32-bit i686 target — the newest
# i686 gcc-fortran is 15.2.0-14. The intrinsic-module format ("GFORTRAN module
# version '16'") and libgfortran SONAME (libgfortran-5) are identical across
# GCC 15 and 16, so the 15.2.0 i686 libgfortran/.mod link against our 16.1.0
# host f951; _package_one_fortran relocates the upstream 15.2.0 gcc-internal
# dir to our 16.1.0 path (see the _libver arg).
source+=("https://repo.msys2.org/mingw/mingw64/mingw-w64-x86_64-gcc-16.1.0-5-any.pkg.tar.zst")
sha256sums+=('10f7c55275f7fbe7924209d61c368a1a6fcf775cffbdeac2eef1f5ccacdd35cd')
source+=("https://repo.msys2.org/mingw/mingw64/mingw-w64-x86_64-gcc-fortran-16.1.0-1-any.pkg.tar.zst")
sha256sums+=('67b994f2fabcd63ec48bcb8028066c17364157597e29be0573903d9e64f08271')
source+=("https://repo.msys2.org/mingw/mingw32/mingw-w64-i686-gcc-16.1.0-5-any.pkg.tar.zst")
sha256sums+=('c945e6fa308b6077ec50c1c628990e24d719af872daf484884668efc21dcfbde')
source+=("https://repo.msys2.org/mingw/mingw32/mingw-w64-i686-gcc-fortran-15.2.0-14-any.pkg.tar.zst")
sha256sums+=('dc80081744cee484cf5bbf5aa932016542825dc35dca2328522d37b943af4ffd')
source+=("https://repo.msys2.org/mingw/ucrt64/mingw-w64-ucrt-x86_64-gcc-16.1.0-5-any.pkg.tar.zst")
sha256sums+=('2b5be791133f5fafac2537ad9d1579c9a421b791d7bf57fba6fb54484ec59622')
source+=("https://repo.msys2.org/mingw/ucrt64/mingw-w64-ucrt-x86_64-gcc-fortran-16.1.0-1-any.pkg.tar.zst")
sha256sums+=('07a33ee5d7cd5918cbc82ca58de515e247d02c0926d925d0189f0f4ba8cceb83')

# ---- Override: make patching tolerant (GCC 15.2.0 may already have some files) ----
apply_patch_with_msg() {
    for _fname in "$@"; do
        msg2 "Applying ${_fname}"
        patch -Nbp1 -i "${srcdir}"/${_fname} || true
    done
}

# ---- Target map ----
declare -A _target_subdir
_target_subdir[x86_64-w64-mingw32]=mingw64
_target_subdir[i686-w64-mingw32]=mingw32
_target_subdir[x86_64-w64-mingw32ucrt]=ucrt64

# ---- _relocate_internal_dirs — fix up upstream<->host gcc-internal path drift ----
# extract_target_libs reads/writes ONE triple and ONE version dir. Two targets
# need post-hoc relocation because the upstream MSYS2 package layout doesn't line
# up with what our host-built driver searches:
#
#   * ucrt64: our host gcc is configured --target=x86_64-w64-mingw32ucrt, so the
#     driver searches lib/gcc/x86_64-w64-mingw32ucrt/<ver> and
#     include/c++/<ver>/x86_64-w64-mingw32ucrt/. But the upstream ucrt64 package
#     stores those bits under the *plain* triple x86_64-w64-mingw32 (MSYS2 builds
#     ucrt with the same triple as mingw64, distinguished only by sysroot). So we
#     extract with the upstream triple, then rename x86_64-w64-mingw32 ->
#     x86_64-w64-mingw32ucrt in every gcc-internal location.
#
#   * mingw32 fortran: MSYS2 never published gcc-fortran 16.1.0 for i686 (newest
#     is 15.2.0-14). We extract that, then rename the upstream 15.2.0 gcc-internal
#     dir to our 16.1.0 path so the host f951 finds the intrinsic .mod files
#     (module format is identical across GCC 15/16, verified).
#
# Args: <pkgdir> <subdir> <upstream-triple> <our-triple> <upstream-ver> <our-ver>
# Renames are no-ops when the names already match (the common mingw64 case), so
# this is safe to call unconditionally.
_relocate_internal_dirs() {
    local pkgdir=$1 subdir=$2 up_triple=$3 our_triple=$4 up_ver=$5 our_ver=$6
    local base d up_path our_path
    # gcc-internal version-specific dirs (root + sysroot-subdir copies) and the
    # C++ target-config header dir all key off <triple>/<ver>.
    for base in \
        "$pkgdir/lib/gcc" \
        "$pkgdir/$subdir/lib/gcc" \
        "$pkgdir/$subdir/include/c++"
    do
        [ -d "$base" ] || continue
        case "$base" in
            */include/c++)
                # layout: include/c++/<ver>/<triple>/bits/...  (triple is the leaf)
                up_path="$base/$up_ver/$up_triple"
                our_path="$base/$our_ver/$our_triple"
                ;;
            *)
                # layout: lib/gcc/<triple>/<ver>/...
                up_path="$base/$up_triple/$up_ver"
                our_path="$base/$our_triple/$our_ver"
                ;;
        esac
        if [ -d "$up_path" ] && [ "$up_path" != "$our_path" ]; then
            mkdir -p "$our_path"
            cp -a "$up_path/." "$our_path/"
            rm -rf "$up_path"
            # prune now-empty upstream parent (e.g. the stale <triple> or <ver> dir)
            rmdir -p "$(dirname "$up_path")" 2>/dev/null || true
        fi
    done
}

# ---- prepare() — MSYS2's + chimera ----
prepare() {
    _msys2_prepare
    cd "${srcdir}/${_realname}-${pkgver}"
    apply_patch_with_msg "${_chimera_patches[@]}"
}

# ---- build() — set up stage prefix (like build_gcc.sh NEWBIN), then MSYS2 loop ----
build() {
    setup_zig_env

    # Stage prefix: like build_gcc.sh $NEWBIN — a writable directory where we
    # create <target> → MSYS2 sysroot symlinks before make.
    _stage_prefix="${srcdir}/stage"
    mkdir -p "$_stage_prefix"

    # Per-target sysroot symlinks (xgcc needs headers/CRT for target libs)
    for _t in x86_64-w64-mingw32 i686-w64-mingw32 x86_64-w64-mingw32ucrt; do
        case "$_t" in
            x86_64-w64-mingw32ucrt) _sub=ucrt64 ;;
            i686*)                  _sub=mingw32 ;;
            x86_64*)                _sub=mingw64 ;;
        esac
        rm -rf "$_stage_prefix/$_t"
        ln -sf "$_bootstrap_prefix/$_sub" "$_stage_prefix/$_t"
    done

    _msys2_build
}

# ---- _package_one — install + cleanup ----
# Like build_gcc.sh, we configured with a staging prefix. DESTDIR install
# puts files at ${pkgdir}${_stage_prefix}/... — move them to ${pkgdir}/.
_package_one() {
    local target=$1
    cd "${srcdir}/gcc-build-${target}"
    # C/C++ only. "install-common" pulls in lang.install-common
    # (c/c++/fortran/lto.install-common) which would also install the gfortran
    # driver — that belongs in the separate -gcc-fortran subpackage. Use
    # "c++.install-common" instead: it installs g++/c++ (and cc1plus); the C
    # driver (gcc/xgcc) comes from "install-driver", which is in the list below.
    # The cc1/cc1plus/lto1/collect2 backends are installed by the explicit loop
    # further down (COMPILERS would also place them via install-common, but we
    # drop install-common to keep Fortran out).
    make -C gcc -j1 DESTDIR="${pkgdir}" \
        c++.install-common install-driver install-cpp install-gcc-ar \
        install-headers install-plugin install-lto-wrapper

    # Resolve the staged install prefix the same way the move below does, so the
    # backend-binary backstop lands in the SAME staged libexec the move drains
    # (not at the package root) regardless of whether _stage_prefix is exported
    # in this shell — keeps full builds and `makepkg -R` repackages consistent.
    local _pfx="${_stage_prefix:-${srcdir}/stage}"
    local _staged="${pkgdir}${_pfx}"
    for b in cc1 cc1plus collect2 lto1 lto-wrapper; do
        [ -f "gcc/$b" ] && install -Dm755 "gcc/$b" "${_staged}/libexec/gcc/${target}/${pkgver}/$b" || true
    done
    # The host LTO linker plugin (liblto_plugin.so) is built by "make all-gcc"
    # under lto-plugin/.libs/, but "make -C gcc install-*" never installs it.
    # The default specs pass -fuse-linker-plugin, so the driver refuses to run
    # without it. Install it into the same versioned libexec dir gcc searches.
    for _lto in lto-plugin/.libs/liblto_plugin.so gcc/liblto_plugin.so; do
        if [ -f "$_lto" ]; then
            install -Dm755 "$_lto" "${_staged}/libexec/gcc/${target}/${pkgver}/liblto_plugin.so"
            break
        fi
    done

    if [ -d "$_staged" ]; then
        for _d in bin lib libexec share; do
            [ -e "$_staged/$_d" ] && mv "$_staged/$_d" "${pkgdir}/"
        done
        # Target libs (libstdc++, libgcc_s, crt, etc.) come from MSYS2 native packages
        rm -rf "$_staged/$target"
        # Remove the empty stage prefix hierarchy (pkgdir/home/...)
        rm -rf "${pkgdir}/home"
    fi

    rm -rf "${pkgdir}/share"
    find "${pkgdir}" -name "*.exe" -delete

    # Ensure -lgcc_s resolves. GCC make install produces libgcc.a (static)
    # but not always libgcc_s.a; ld needs both since GCC links with -lgcc_s -lgcc.
    local _verlib="${pkgdir}/lib/gcc/${target}/${pkgver}"
    if [ -f "$_verlib/libgcc_s.a" ] && [ ! -L "$_verlib/libgcc_s.a" ]; then
        mv "$_verlib/libgcc_s.a" "${pkgdir}/lib/libgcc_s.a"
        ln -sf ../../../libgcc_s.a "$_verlib/libgcc_s.a"
    elif [ ! -f "$_verlib/libgcc_s.a" ] && [ -f "$_verlib/libgcc.a" ]; then
        ln -sf libgcc.a "$_verlib/libgcc_s.a"
    fi
}

# ---- _package_one_fortran — gfortran driver + f951 backend (host) + libgfortran ----
# Fortran subpackage: gfortran driver + f951 backend (host) + libgfortran (target,
# repackaged from upstream). Split out so users who don't need Fortran install
# only the smaller -gcc package. Mirrors upstream native package_gcc-fortran():
# fortran.install-common installs the gfortran driver; f951 is installed by hand
# (the build Makefile only installs it via install-common's COMPILERS loop, which
# we deliberately don't run here); libgfortran.a/.dll.a/.spec + finclude .mod
# files come from the upstream -gcc-fortran binary package.
# Args: <our-target-triple> <upstream-fortran-pkg> <sysroot-subdir> \
#       [<upstream-triple>] [<upstream-ver>]
#   * <our-target-triple>  — the triple our host gcc was configured with
#     (x86_64-w64-mingw32 / i686-w64-mingw32 / x86_64-w64-mingw32ucrt); names the
#     build dir, the host f951 dest, and the path the driver searches.
#   * <sysroot-subdir>     — mingw64/mingw32/ucrt64 (the dir name inside the
#     upstream package AND the installed filesystem symlink target).
#   * <upstream-triple>    — triple the upstream package stores its gcc-internal
#     bits under (defaults to <our-target-triple>; differs for ucrt64, which MSYS2
#     ships under the plain x86_64-w64-mingw32 triple).
#   * <upstream-ver>       — gcc version inside the upstream package (defaults to
#     $pkgver; the i686 gcc-fortran is 15.2.0, not 16.1.0).
# After extraction, _relocate_internal_dirs renames the upstream triple/version
# gcc-internal dirs to the ones our driver searches (no-op when they match).
_package_one_fortran() {
    local target=$1 fpkg=$2 subdir=$3
    local up_triple="${4:-$target}" up_ver="${5:-$pkgver}"
    cd "${srcdir}/gcc-build-${target}"
    make -C gcc -j1 DESTDIR="${pkgdir}" fortran.install-common
    local _pfx="${_stage_prefix:-${srcdir}/stage}"
    local _staged="${pkgdir}${_pfx}"
    # f951 backend binary (host)
    [ -f "gcc/f951" ] && install -Dm755 "gcc/f951" "${_staged}/libexec/gcc/${target}/${pkgver}/f951"
    if [ -d "$_staged" ]; then
        # Move (not copy) the staged host bits to the package root. The -gcc and
        # -gcc-fortran packages build from the SAME build dir but install disjoint
        # files (c++.install-common vs fortran.install-common have no overlap),
        # so a plain mv is safe and avoids any cross-package file claim.
        for _d in bin lib libexec share; do
            [ -e "$_staged/$_d" ] && mv "$_staged/$_d" "${pkgdir}/"
        done
        rm -rf "$_staged/$target" "${pkgdir}/home"
    fi
    rm -rf "${pkgdir}/share"
    find "${pkgdir}" -name "*.exe" -delete
    # libgfortran.a/.dll.a/.spec + finclude/.mod + libcaf_*.a from upstream -gcc-fortran.
    # Extract under the UPSTREAM triple/ver (what's actually in the package), then
    # relocate to our target triple / $pkgver.
    extract_target_libs "$srcdir/$fpkg" "$up_triple" "$up_ver" "$pkgdir" "" "$subdir"
    _relocate_internal_dirs "$pkgdir" "$subdir" "$up_triple" "$target" "$up_ver" "$pkgver"
}

package_msys-cross-mingw64-gcc() {
    pkgdesc="Cross GCC for x86_64-w64-mingw32 target (gcc/g++)"
    depends=(msys-cross-filesystem msys-cross-mingw64-binutils
             mingw-w64-x86_64-headers mingw-w64-x86_64-crt
             mingw-w64-x86_64-winpthreads mingw-w64-x86_64-gcc-libs
             mingw-w64-x86_64-zlib mingw-w64-x86_64-windows-default-manifest)
    _package_one "x86_64-w64-mingw32"
    # _package_one moves bin/lib/libexec out of the stage prefix to the package
    # root (the package installs at "/"), so the extracted target libs must also
    # land at the package root — pass "" as the stage-prefix arg, not
    # $_stage_prefix (which now points at the already-drained stage subtree).
    # The runtime libs/headers go under the MSYS2 sysroot subdir (mingw64), which
    # the filesystem package's "x86_64-w64-mingw32 -> mingw64" symlink resolves
    # the cross-gcc search path to (avoids a real-dir vs symlink install clash).
    # C/C++ libs only — libgfortran moves to the -gcc-fortran subpackage.
    extract_target_libs \
        "$srcdir/mingw-w64-x86_64-gcc-16.1.0-5-any.pkg.tar.zst" \
        "x86_64-w64-mingw32" "$pkgver" "$pkgdir" "" "mingw64"
}

package_msys-cross-mingw64-gcc-fortran() {
    pkgdesc="Cross GFortran for x86_64-w64-mingw32 target"
    depends=(msys-cross-mingw64-gcc mingw-w64-x86_64-gcc-libs)
    _package_one_fortran "x86_64-w64-mingw32" "mingw-w64-x86_64-gcc-fortran-16.1.0-1-any.pkg.tar.zst" "mingw64"
}

package_msys-cross-mingw32-gcc() {
    pkgdesc="Cross GCC for i686-w64-mingw32 target (gcc/g++)"
    depends=(msys-cross-filesystem msys-cross-mingw32-binutils
             mingw-w64-i686-headers mingw-w64-i686-crt
             mingw-w64-i686-winpthreads mingw-w64-i686-gcc-libs
             mingw-w64-i686-zlib mingw-w64-i686-windows-default-manifest)
    _package_one "i686-w64-mingw32"
    # C/C++ target libs from upstream i686 gcc. The i686 build triple equals the
    # upstream package triple (i686-w64-mingw32) and version (16.1.0), so a plain
    # extraction lands everything at the path the driver searches — no relocation.
    extract_target_libs \
        "$srcdir/mingw-w64-i686-gcc-16.1.0-5-any.pkg.tar.zst" \
        "i686-w64-mingw32" "$pkgver" "$pkgdir" "" "mingw32"
}

package_msys-cross-mingw32-gcc-fortran() {
    pkgdesc="Cross GFortran for i686-w64-mingw32 target"
    depends=(msys-cross-mingw32-gcc mingw-w64-i686-gcc-libs)
    # MSYS2 has no gcc-fortran 16.1.0 for i686; newest is 15.2.0-14. The .mod
    # module format and libgfortran SONAME are stable across GCC 15/16, so the
    # 15.2.0 libgfortran/.mod link against our 16.1.0 host f951. Pass the upstream
    # triple (== our triple here) and the upstream version 15.2.0 so the extracted
    # gcc-internal dir is relocated from 15.2.0 to our 16.1.0 search path.
    _package_one_fortran "i686-w64-mingw32" \
        "mingw-w64-i686-gcc-fortran-15.2.0-14-any.pkg.tar.zst" "mingw32" \
        "i686-w64-mingw32" "15.2.0"
}

package_msys-cross-ucrt64-gcc() {
    pkgdesc="Cross GCC for x86_64-w64-mingw32ucrt target (gcc/g++)"
    depends=(msys-cross-filesystem msys-cross-ucrt64-binutils
             mingw-w64-ucrt-x86_64-headers mingw-w64-ucrt-x86_64-crt
             mingw-w64-ucrt-x86_64-winpthreads mingw-w64-ucrt-x86_64-gcc-libs
             mingw-w64-ucrt-x86_64-zlib mingw-w64-ucrt-x86_64-windows-default-manifest)
    _package_one "x86_64-w64-mingw32ucrt"
    # C/C++ target libs from upstream ucrt64 gcc. MSYS2 stores the ucrt gcc-internal
    # bits under the PLAIN triple x86_64-w64-mingw32 (not mingw32ucrt), so extract
    # under that triple then relocate to our x86_64-w64-mingw32ucrt search path
    # (lib/gcc/<triple>/<ver> + include/c++/<ver>/<triple>). Runtime libs land in
    # ucrt64/lib, which is triple-independent and reached via the symlink.
    extract_target_libs \
        "$srcdir/mingw-w64-ucrt-x86_64-gcc-16.1.0-5-any.pkg.tar.zst" \
        "x86_64-w64-mingw32" "$pkgver" "$pkgdir" "" "ucrt64"
    _relocate_internal_dirs "$pkgdir" "ucrt64" \
        "x86_64-w64-mingw32" "x86_64-w64-mingw32ucrt" "$pkgver" "$pkgver"
}

package_msys-cross-ucrt64-gcc-fortran() {
    pkgdesc="Cross GFortran for x86_64-w64-mingw32ucrt target"
    depends=(msys-cross-ucrt64-gcc mingw-w64-ucrt-x86_64-gcc-libs)
    # Upstream ucrt64 gcc-fortran 16.1.0-1 stores its gcc-internal bits under the
    # plain triple x86_64-w64-mingw32 — extract under it and relocate to our
    # x86_64-w64-mingw32ucrt search path (version matches, only the triple drifts).
    _package_one_fortran "x86_64-w64-mingw32ucrt" \
        "mingw-w64-ucrt-x86_64-gcc-fortran-16.1.0-1-any.pkg.tar.zst" "ucrt64" \
        "x86_64-w64-mingw32" "$pkgver"
}
