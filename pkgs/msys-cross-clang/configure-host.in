#!/bin/sh
# msys-cross-clang configure-host
# Detects host clang/lld/llvm-* and writes the wrapper + cfg files.
# Usage: configure-host [clang64|clangarm64|all]
set -e

SELF_DIR="$(cd "$(dirname "$0")" && pwd)"
PREFIX="$(cd "$SELF_DIR/../.." && pwd)"

TARGETS="${1:-all}"

die() { echo "configure-host: $*" >&2; exit 1; }

# ---- Detect host clang (22 → 19) ----
detect_clang() {
    for v in 22 21 20 19; do
        if command -v "clang-$v" >/dev/null 2>&1; then
            CLANG_BIN="$(command -v "clang-$v")"
            CLANG_VER="$v"
            return 0
        fi
    done
    if command -v clang >/dev/null 2>&1; then
        CLANG_BIN="$(command -v clang)"
        CLANG_VER="$(clang --version | head -1 | sed -n 's/.*version \([0-9]*\).*/\1/p')"
        [ "${CLANG_VER:-0}" -ge 19 ] || die "clang $CLANG_VER too old (need >= 19)"
        return 0
    fi
    die "clang not found (need clang-22..19 or unversioned clang >= 19)"
}

detect_lld() {
    # Prefer same version as clang
    if [ -x "/usr/bin/lld-$CLANG_VER" ]; then
        LLD_BIN="/usr/bin/lld-$CLANG_VER"
    elif [ -x "/usr/bin/ld.lld-$CLANG_VER" ]; then
        LLD_BIN="/usr/bin/ld.lld-$CLANG_VER"
    elif command -v "lld-$CLANG_VER" >/dev/null 2>&1; then
        LLD_BIN="$(command -v "lld-$CLANG_VER")"
    elif command -v lld >/dev/null 2>&1; then
        LLD_BIN="$(command -v lld)"
    elif command -v ld.lld >/dev/null 2>&1; then
        LLD_BIN="$(command -v ld.lld)"
    else
        die "lld not found (need lld-$CLANG_VER or unversioned lld)"
    fi
}

detect_llvm_tools() {
    # Find a directory containing llvm-ar-$CLANG_VER (preferred) or llvm-ar
    if [ -x "/usr/bin/llvm-ar-$CLANG_VER" ]; then
        LLVM_TOOLDIR="/usr/bin"
        LLVM_SUFFIX="-$CLANG_VER"
    elif command -v "llvm-ar-$CLANG_VER" >/dev/null 2>&1; then
        LLVM_TOOLDIR="$(dirname "$(command -v "llvm-ar-$CLANG_VER")")"
        LLVM_SUFFIX="-$CLANG_VER"
    elif command -v llvm-ar >/dev/null 2>&1; then
        LLVM_TOOLDIR="$(dirname "$(command -v llvm-ar)")"
        LLVM_SUFFIX=""
    else
        die "llvm-ar not found (install llvm-$CLANG_VER or llvm)"
    fi
    # Sanity check
    for t in ar ranlib strip nm objdump objcopy readobj dlltool windres rc; do
        if [ ! -x "$LLVM_TOOLDIR/llvm-$t$LLVM_SUFFIX" ]; then
            echo "configure-host: warning: $LLVM_TOOLDIR/llvm-$t$LLVM_SUFFIX missing" >&2
        fi
    done
}

detect_target_support() {
    case "$1" in
        clang64)
            "$CLANG_BIN" --print-targets 2>/dev/null | grep -q '^[[:space:]]*x86-64' \
                || die "host clang missing x86-64 target"
            ;;
        clangarm64)
            "$CLANG_BIN" --print-targets 2>/dev/null | grep -q '^[[:space:]]*aarch64' \
                || die "host clang missing aarch64 target"
            ;;
    esac
}

detect_sysroot_llvm_ver() {
    # $1: msystem (clang64 / clangarm64)
    local d="$PREFIX/$1/lib/clang"
    [ -d "$d" ] || die "sysroot not installed: $d (run msys-pacman -S mingw-w64-clang-* first)"
    SYSROOT_LLVM_VER="$(ls -1 "$d" 2>/dev/null | sort -V | tail -1)"
    [ -n "$SYSROOT_LLVM_VER" ] || die "no LLVM resource dir under $d"
}

# ---- Render wrapper ----
render_wrapper() {
    local src="$PREFIX/libexec/msys-cross-clang/wrapper.in"
    local dst="$PREFIX/libexec/msys-cross-clang/wrapper"
    [ -r "$src" ] || die "wrapper.in not found at $src"
    sed \
        -e "s|@CLANG_BIN@|$CLANG_BIN|g" \
        -e "s|@LLD_BIN@|$LLD_BIN|g" \
        -e "s|@LLVM_TOOLDIR@|$LLVM_TOOLDIR|g" \
        -e "s|@LLVM_SUFFIX@|$LLVM_SUFFIX|g" \
        "$src" > "$dst"
    chmod 755 "$dst"
}

render_cfg() {
    # $1: msystem
    local src="$PREFIX/etc/clang/$1.cfg.in"
    local dst="$PREFIX/etc/clang/$1.cfg"
    [ -r "$src" ] || die "$src not found"
    sed -e "s|@SYSROOT_LLVM_VER@|$SYSROOT_LLVM_VER|g" \
        -e "s|@HOST_RESOURCE_DIR@|$HOST_RESOURCE_DIR|g" \
        "$src" > "$dst"
}

detect_host_resource_dir() {
    HOST_RESOURCE_DIR="$("$CLANG_BIN" -print-resource-dir 2>/dev/null)"
    [ -d "$HOST_RESOURCE_DIR/include" ] \
        || die "host clang resource dir missing intrinsics ($HOST_RESOURCE_DIR/include)"
}

# ---- Main ----
detect_clang
detect_lld
detect_llvm_tools
detect_host_resource_dir

echo "configure-host: host clang  = $CLANG_BIN (LLVM $CLANG_VER)"
echo "configure-host: host lld    = $LLD_BIN"
echo "configure-host: llvm tools  = $LLVM_TOOLDIR/llvm-*$LLVM_SUFFIX"

render_wrapper

case "$TARGETS" in
    clang64|all)
        detect_target_support clang64
        detect_sysroot_llvm_ver clang64
        render_cfg clang64
        echo "configure-host: clang64 cfg ready (sysroot LLVM $SYSROOT_LLVM_VER)"
        ;;
esac

case "$TARGETS" in
    clangarm64|all)
        detect_target_support clangarm64
        if [ -d "$PREFIX/clangarm64/lib/clang" ]; then
            detect_sysroot_llvm_ver clangarm64
            render_cfg clangarm64
            echo "configure-host: clangarm64 cfg ready (sysroot LLVM $SYSROOT_LLVM_VER)"
        else
            echo "configure-host: clangarm64 sysroot not installed; skipping" >&2
        fi
        ;;
esac

echo "configure-host: done."
